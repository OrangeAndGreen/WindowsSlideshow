<Window x:Class="ViggiSlideshow.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viggi Slideshow settings"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20" Width="520">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Caption}" Text="Folder" />
            <DockPanel Grid.Row="0" Grid.Column="1">
                <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,3" Margin="8,0,0,0" Click="Browse_Click" />
                <TextBox x:Name="FolderBox" />
            </DockPanel>

            <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="Show" />
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ModeBox" HorizontalAlignment="Left" MinWidth="200">
                <ComboBoxItem Content="Photos and videos" />
                <ComboBoxItem Content="Photos only" />
                <ComboBoxItem Content="Videos only" />
            </ComboBox>

            <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Text="Order" />
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="OrderBox" HorizontalAlignment="Left" MinWidth="200">
                <ComboBoxItem Content="Random" />
                <ComboBoxItem Content="Folder order" />
            </ComboBox>

            <TextBlock Grid.Row="6" Style="{StaticResource Caption}" Text="Seconds per photo" />
            <TextBox Grid.Row="6" Grid.Column="1" x:Name="IntervalBox" Width="80" HorizontalAlignment="Left" />

            <TextBlock Grid.Row="8" Style="{StaticResource Caption}" Text="Longest video (seconds)" />
            <TextBox Grid.Row="8" Grid.Column="1" x:Name="VideoMaxBox" Width="80" HorizontalAlignment="Left" />

            <TextBlock Grid.Row="10" Style="{StaticResource Caption}" Text="Fade (milliseconds)" />
            <TextBox Grid.Row="10" Grid.Column="1" x:Name="FadeBox" Width="80" HorizontalAlignment="Left" />
        </Grid>

        <StackPanel Margin="0,16,0,0">
            <CheckBox x:Name="SoundBox" Content="Play video sound" Margin="0,0,0,6" />
            <CheckBox x:Name="FileNameBox" Content="Show the file name" Margin="0,0,0,6" />
            <CheckBox x:Name="InfoBox" Content="Show file info (size, date taken, camera)" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="Firebrick" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <Expander Header="Keys while it's running" Margin="0,16,0,0">
            <TextBlock x:Name="KeysText" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,8,0,0" />
        </Expander>

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center">
                <Hyperlink Click="Log_Click">Open the log</Hyperlink>
            </TextBlock>
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Width="80" Margin="8,0,0,0" Padding="0,4" />
            <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" Width="80" Padding="0,4" Click="Ok_Click" />
        </DockPanel>
    </StackPanel>
</Window>
